# Copy this file to `.env.local` for local development, and add the same two values in
# Vercel (Project -> Settings -> Environment Variables). Both are PUBLIC browser settings.
# Never put a secret key, service_role key or database password in a VITE_ variable.

# Supabase dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase dashboard -> Project Settings -> API Keys -> Publishable key (starts with sb_publishable_)
# (The legacy "anon" key also works here if your project doesn't show a publishable key.)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
